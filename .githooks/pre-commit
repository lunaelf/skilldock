#!/usr/bin/env sh
# skilldock tool-repo pre-commit gate: format-check, lint, and test the Rust
# workspace (core + cli). Bypass with `git commit --no-verify`.
#
# Enable in a fresh clone with:  git config core.hooksPath .githooks
set -e

# The test suite shells out to `git` inside throwaway temp repos. Git exports
# GIT_DIR / GIT_INDEX_FILE / GIT_WORK_TREE / GIT_PREFIX into hooks; left set,
# they redirect those child `git` calls at THIS repo mid-commit (the index is
# locked → tests fail). Clear them so each test targets its own directory.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

cargo fmt --all --check
cargo clippy --all-targets -- -D warnings
cargo test
